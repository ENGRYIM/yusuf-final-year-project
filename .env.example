VITE_FIREBASE_DATABASE_URL=https://yimded-e7b27-default-rtdb.europe-west1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=yimded-e7b27
VITE_FIREBASE_STORAGE_BUCKET=yimded-e7b27.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
